# Copy to .env and fill in. Nothing here is read at import time except through
# qte_shared.config, so a missing value fails loudly at startup, not silently.

QTE_ENV=dev
# Immutable book: dev (simulation), shadow (paper), live (broker).
# Switching mode/provider selects fresh state; see docs/state-isolation.md.
# Live requires QTE_ENV=prod and an explicitly disabled broker shadow gate.
QTE_STATE__MODE=shadow
QTE_LOG_LEVEL=INFO

# ── Host ports ────────────────────────────────────────────────────────
# Only the *host* side of each published port. Inside the compose network the
# containers keep talking on the standard ports, so the URLs above never change
# when you move these. Shift them when something else on the box — typically
# algo-trading-broker's own Postgres and NATS — already owns the default.
QTE_REDIS_PORT=6379
QTE_POSTGRES_PORT=5432
QTE_NATS_PORT=4222
# NATS' HTTP monitoring endpoint (/varz, /connz).
QTE_NATS_MONITOR_PORT=8222
# Only published on the dev profile; nothing binds it otherwise.
QTE_SIMULATOR_PORT=8901

# ── QTE's own event bus ───────────────────────────────────────────────
QTE_NATS__URL=nats://nats:4222
QTE_NATS__TOKEN=
QTE_NATS__SUBJECT_PREFIX=QTE

# ── Sending signals to algo-trading-broker ────────────────────────────
# nats  = publish {"payload": ...} to the broker's JetStream SIGNALS.<strategy>
#         (its own webhook endpoint writes to the same stream). Fast, durable,
#         and authenticated by NATS access rather than by the token below.
# http  = POST {QTE_BROKER__HTTP_URL}/secret/webhook, which does verify the
#         token. Use this across any network boundary you do not control.
QTE_BROKER__TRANSPORT=nats
# Blank means "reuse QTE_NATS__URL" — correct only when QTE and the broker
# share one NATS cluster. Otherwise point this at the broker's.
QTE_BROKER__NATS_URL=
QTE_BROKER__NATS_TOKEN=
QTE_BROKER__HTTP_URL=http://algo-trading-broker:8080
# Must match the broker's WEBHOOK_TOKEN. Only enforced on the http transport.
QTE_BROKER__TOKEN=
# TRUE = build, log and audit signals but do NOT send them. Phase 6 paper
# trading. Leave it on until reconciliation looks right.
QTE_BROKER__SHADOW_MODE=true
# Deployment override: true forbids live delivery even if Redis stores shadow off.
QTE_BROKER__FORCE_SHADOW_MODE=false

# ── Hot state ─────────────────────────────────────────────────────────
QTE_REDIS__URL=redis://redis-cache:6379/0
# Bars kept per symbol and timeframe. This is the *whole* window the strategy
# runner can warm from, so it has to cover the deepest history any strategy
# asks for: 6000 M15 bars is roughly 60 trading days. A strategy wanting more
# than this gets a warning at boot and silently less history than a backtest.
QTE_REDIS__CANDLE_HISTORY=6000

# ── Database Audit trail ───────────────────────────────────────────────────────
POSTGRES_USER=qte
POSTGRES_PASSWORD=qte
POSTGRES_DB=qte_audit
# Host tools use the published port; URL-encode credentials in an explicit DSN.
QTE_POSTGRES__DSN=postgresql+asyncpg://qte:qte@localhost:5432/qte_audit
# Containers construct their DSN from POSTGRES_* above, encoding credentials.
# Set this only to override that container DSN (for example an external DB).
QTE_CONTAINER_POSTGRES_DSN=
QTE_POSTGRES__ENABLED=true

# ── Strategy runner ───────────────────────────────────────────────────
# Audit __strategies__/ on every start, in the runner's own process:
#   off     don't.
#   warn    log the report, start anyway (the loader skips what it can't drive).
#   error   refuse to start when the audit found errors.
#   strict  refuse on warnings too — same reading as `make audit-strict`.
QTE_RUNNER__AUDIT_ON_START=warn
# The `numba` logger tree, independent of QTE_LOG_LEVEL above. pandas-ta
# indicators are numba-JIT'd, and its SSA/byteflow compilation passes log one
# DEBUG line per step — enough to drown the runner's own log when
# QTE_LOG_LEVEL=DEBUG. Leave this at warning; drop it only to debug numba
# itself.
QTE_RUNNER__NUMBA_LOG_LEVEL=warning
# Which strategies run is not set here. The runner loads every strategy that
# `make strategy-mount` recorded as passing its audit in
# __strategies__/strategies.toml, and config/strategies_mapping.toml then pairs
# each of them with the symbols it trades — one mapped to none does not run.
# Per-strategy parameters live in that same table, under [strategies.<name>];
# per-pair overrides go under [symbols.<sym>.params].
# Fallback size only. Entries are normally risk-sized against QTE_ACCOUNT__*
# below. Only missing sizing inputs may use a fallback, still capped and
# rounded down. Invalid budgets, zero-distance stops and substep sizes reject.
QTE_RUNNER__DEFAULT_QUANTITY=0.01
# A close published while the runner was down or still starting is fed to the
# strategy on start. It is decided on only if it closed at most this many
# seconds ago; an older one joins the indicator window as history, because an
# entry sent minutes late goes out at a price the backtest never traded.
QTE_RUNNER__CATCH_UP_MAX_AGE=120
# Periodic Redis reconciliation also repairs lost NATS closes and late backfill.
QTE_RUNNER__HISTORY_SYNC_INTERVAL=5
# The weekend flat. A strategy's own repository declares *when* its market shuts
# — a weekday and a wall-clock time, in its settings file beside its alias table
# — and the engine enforces it: inside that window it refuses new entries and
# closes any open position with a FLAT. Exits are never blocked.
#
# This variable is the other half: whose clock those times are read on. UTC
# takes them literally, which is what the mounted strategies write them in. Set
# an IANA zone (Europe/Nicosia, America/New_York) when the broker closes on a
# local exchange calendar and you want the declared times to follow its
# daylight-saving changes. It is QTE_ENGINE__ and not QTE_RUNNER__ on purpose:
# the backtest reads it too, or a replay would stop predicting what the runner
# does over a Friday evening.
QTE_ENGINE__WEEKEND_FLAT_TIMEZONE=UTC
# How often the runner also checks that window *between* bars. Bar-driven
# flattening is the path the backtest takes as well, but on its own a feed that
# stalls at 16:50 on a Friday leaves no close to act on and the position rides
# through the weekend. Seconds; 0 disables the sweep.
QTE_RUNNER__WEEKEND_FLAT_SWEEP_INTERVAL=60
# Required in both ingestion and runner when any strategy overrides on_tick,
# or QTE_RUNNER__SUBSCRIBE_TICKS=true; the runner refuses incompatible startup.
QTE_INGESTION__PUBLISH_TICKS=false
QTE_RUNNER__DELIVERY_RETRY_INTERVAL=5
# Unknown live outcomes require reconciliation by default. Set a positive
# horizon ONLY after verifying broker deduplication for this transport; it must
# fit strictly inside that guarantee, allowing time for the publish timeout.
QTE_RUNNER__DELIVERY_RETRY_MAX_AGE=0

# ── Market data ───────────────────────────────────────────────────────
# Which vendor, and the one secret that goes with it. *What* it feeds — the
# symbols, their markets and timeframes, and the vendor's own knobs — is a
# per-symbol matrix and lives in a file instead:
#
#   config/<provider>.toml        `make tiingo` / `make simulator` write it
#
# `make start` refuses to run without that file, whichever provider is on:
# `config/tiingo.toml` here, `config/simulator.toml` for local dev on the
# WebSocket `simulator`. The simulator needs the plan but no key.
QTE_MARKET_DATA__PROVIDER=tiingo
# One key name whichever vendor is on, so switching provider does not
# invalidate a deployed secret.
QTE_DATA_PROVIDER_API_KEY=
# Point the plan somewhere else — a mounted secret, a per-environment file.
# Empty means config/<provider>.toml.
#QTE_MARKET_DATA__CONFIG_FILE=
# Optional symbols/timeframes overrides win over the plan. Timeframes apply
# to every selected symbol; without an override, each keeps its planned bars.
# New symbols must declare a market in QTE_INGESTION__MARKET_OVERRIDES.
#QTE_ENGINE__SYMBOLS=["EURUSD"]
#QTE_ENGINE__TIMEFRAMES=["M5"]
#QTE_ENGINE__SIGNAL_TIMEFRAME=M5
#QTE_INGESTION__MARKET_OVERRIDES={"EURUSD":"fx"}

# ── The trading account ───────────────────────────────────────────────
# Starting capital, and what every entry is risk-sized against:
#   quantity = CAPITAL x risk_percent / 100 / |entry - stop| / CONTRACT_SIZE
# Fixed for a whole run — it does not compound, so two backtests stay
# comparable. `use_equity_sizing` on a payload reports the pair's configured
# mode to the broker and never changes this number.
QTE_ACCOUNT__CAPITAL=1000.0
# Fallback risk per entry. A pair's own risk_percent in
# config/strategies_mapping.toml wins over this.
QTE_ACCOUNT__RISK_PERCENT=1.0
# Backtest cost model: charged per unit on entry and on every partial exit.
QTE_ACCOUNT__COMMISSION_PER_UNIT=0.0
# Units per contract/lot. Scales P&L and commission alike.
QTE_ACCOUNT__CONTRACT_SIZE=1.0
# Ceiling on a sized entry; 0 = uncapped. Decimals a size is rounded to.
QTE_ACCOUNT__MAX_QUANTITY=0.0
QTE_ACCOUNT__QUANTITY_PRECISION=4

# ── Dev-only market data simulator ────────────────────────────────────
# A WebSocket feed you drive by hand (docs/simulator.md). It refuses to start
# unless QTE_ENV=dev, and so does the provider that connects to it — it
# fabricates prices, and a live engine reading them would look entirely normal
# doing it.
#
# To rehearse the pipeline, point ingestion at it and start it on the dev
# compose profile:
#   QTE_MARKET_DATA__PROVIDER=simulator
#   docker compose --profile dev up -d market-simulator
#
# Where the feed is. Use the service name from inside compose, 127.0.0.1 when
# ingestion runs on the host (`make ingestion`).
QTE_SIMULATOR__URL=ws://market-simulator:8901/stream
# Where the server binds, and where the CLI dials to drive it. 0.0.0.0 is an
# address to listen on, never one to connect to — hence two settings.
QTE_SIMULATOR__HOST=0.0.0.0
# Changing this means changing QTE_SIMULATOR__URL and QTE_SIMULATOR__CONTROL_URL
# with it — compose maps the published port onto whatever this says.
QTE_SIMULATOR__PORT=8901
QTE_SIMULATOR__CONTROL_URL=ws://127.0.0.1:8901/control
# Log every tick the simulator sends. Off by default (a walk fills a terminal),
# but it settles "did the simulator send it, or did ingestion drop it?".
QTE_SIMULATOR__LOG_TICKS=false

# Cached vendor history for `make warmup-cache`. A bare `qte-simulator replay`
# plays the last QTE_SIMULATOR__CACHE_BARS of this file into the feed, so a dev
# stack rehearses on prices that really printed without spending a request
# against a rate-limited plan. The file's own timestamps are ignored: the run is
# re-anchored onto the buckets ending at the current one, which is what makes
# the warm-up look like history the runner just missed. Leave it empty if there
# is none — `replay` then needs --file or --generate.
QTE_SIMULATOR_PARQUET_FILE=data/parquet/tiingo/XAUUSD_M15.parquet
# How many of that file's trailing bars to play. Unset it follows
# QTE_REDIS__CANDLE_HISTORY, so one run fills exactly the window the runner
# reads back. The CLI sends them in batches; the server caps one command at
# 5000 bars.
#QTE_SIMULATOR__CACHE_BARS=6000
# Bars a bare `--generate` synthesises. Unset it follows
# QTE_ENGINE__WARMUP_CANDLES, which is what the strategies are waiting for.
#QTE_SIMULATOR__GENERATE_BARS=300
